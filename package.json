{
  "name": "deposit-kit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "server": "node server/node.ts",
    "verify:tsa": "node scripts/verify-timestamp.ts",
    "dev:phone": "vite --host --mode phone",
    "preview:phone": "vite build && vite preview --host --mode phone --port 5173",
    "build:native": "tsc -b && vite build --mode native && cap sync",
    "ios": "cap open ios",
    "android": "cap open android",
    "check:launch": "node scripts/check-launch.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/share": "^8.0.3",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "preact": "^11.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.19.2",
    "fake-indexeddb": "^6.2.8",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22.18"
  }
}
